default_platform(:ios)

PROJECT = "Timezen.xcodeproj"
SCHEME  = "Timezen"

platform :ios do
  # App Store Connect API key built from CI env vars (see RELEASE.md).
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build a signed Release .ipa and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Keychain + non-interactive setup on CI runners.
    setup_ci if ENV["CI"]

    # Fetch distribution cert + provisioning profiles (app + widget) stored via `match`.
    app_id = "com.afanasievmaksym.timezen"
    widget_id = "com.afanasievmaksym.timezen.TimezenWidgets"
    match(type: "appstore", app_identifier: [app_id, widget_id],
          readonly: ENV["CI"] ? true : false, api_key: api_key)

    # Switch both targets to manual signing with their match profiles (the project ships
    # with automatic signing, which can't produce an App Store archive on a CI runner).
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, team_id: "2ZAN8NR82A",
                                 targets: ["Timezen"], code_sign_identity: "Apple Distribution",
                                 profile_name: "match AppStore #{app_id}")
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, team_id: "2ZAN8NR82A",
                                 targets: ["TimezenWidgets"], code_sign_identity: "Apple Distribution",
                                 profile_name: "match AppStore #{widget_id}")

    # Next build number = latest TestFlight build + 1 (keeps uploads monotonic).
    build = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => "match AppStore #{app_id}",
          widget_id => "match AppStore #{widget_id}",
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Promote the latest TestFlight build's metadata & submit to App Store review"
  lane :release do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      submit_for_review: false,   # flip to true once metadata/screenshots are ready
      force: true,                # skip HTML preview
      skip_binary_upload: true,   # binary already on TestFlight via `beta`
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
