default_platform(:ios)

PROJECT = "Timezen.xcodeproj"
SCHEME  = "Timezen"

platform :ios do
  # App Store Connect API key built from CI env vars (see RELEASE.md).
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build a signed Release .ipa and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Keychain + non-interactive setup on CI runners.
    setup_ci if ENV["CI"]

    # Fetch distribution cert + provisioning profiles (app + widget) stored via `match`.
    app_id = "com.afanasievmaksym.timezen"
    widget_id = "com.afanasievmaksym.timezen.TimezenWidgets"
    match(type: "appstore", app_identifier: [app_id, widget_id],
          readonly: ENV["CI"] ? true : false, api_key: api_key)

    # Switch both targets to manual signing with their match profiles (the project ships
    # with automatic signing, which can't produce an App Store archive on a CI runner).
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, team_id: "2ZAN8NR82A",
                                 targets: ["Timezen"], code_sign_identity: "Apple Distribution",
                                 profile_name: "match AppStore #{app_id}")
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, team_id: "2ZAN8NR82A",
                                 targets: ["TimezenWidgets"], code_sign_identity: "Apple Distribution",
                                 profile_name: "match AppStore #{widget_id}")

    # Next build number = latest TestFlight build + 1 (keeps uploads monotonic).
    build = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_id => "match AppStore #{app_id}",
          widget_id => "match AppStore #{widget_id}",
        }
      }
    )

    groups = ENV["TESTFLIGHT_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
    changelog = ENV["CHANGELOG"].to_s.strip
    changelog = last_git_commit[:message].to_s.strip if changelog.empty?

    upload_to_testflight(
      api_key: api_key,
      changelog: changelog,
      # External distribution needs the processed build.
      skip_waiting_for_build_processing: groups.empty?,
      distribute_external: !groups.empty?,
      groups: groups.empty? ? nil : groups,
      # Apple allows one build per version in beta review; replace the older one with this build.
      reject_build_waiting_for_review: !groups.empty?
    )
  end

  desc "Submit the latest TestFlight build of the current version to App Store review"
  lane :release do
    api_key = asc_api_key
    version = get_version_number(xcodeproj: PROJECT, target: "Timezen")

    app = Spaceship::ConnectAPI::App.find("com.afanasievmaksym.timezen")
    existing = app.get_app_store_versions(filter: { versionString: version }).first
    editable = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED]
    if existing && !editable.include?(existing.app_store_state)
      UI.important("#{version} is already #{existing.app_store_state}; bump MARKETING_VERSION to release. Skipping.")
      next
    end

    build = latest_testflight_build_number(api_key: api_key, version: version)
    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build.to_s,
      release_notes: { "default" => File.read(File.expand_path("whats_new.txt", __dir__)).strip },
      submit_for_review: true,
      automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false },
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false
    )
  end
end
